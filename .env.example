# Needed when the AI assistant is connected to the backend.
OPENAI_API_KEY=your_openai_api_key

# Synthetic examples only. Create separate local PostgreSQL databases first.
# The backend reads the root .env; explicitly set environment variables win.
DATABASE_URL=postgresql+psycopg://rentalops:local-example-only@127.0.0.1:5432/rentalops
TEST_DATABASE_URL=postgresql+psycopg://rentalops:local-example-only@127.0.0.1:5432/rentalops_test
