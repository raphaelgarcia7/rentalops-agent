# Needed when the AI assistant is connected to the backend.
OPENAI_API_KEY=your_openai_api_key

# Synthetic examples only. Create separate local PostgreSQL databases first.
# The backend reads the root .env; explicitly set environment variables win.
DATABASE_URL=postgresql+psycopg://rentalops:local-example-only@127.0.0.1:5432/rentalops
TEST_DATABASE_URL=postgresql+psycopg://rentalops:local-example-only@127.0.0.1:5432/rentalops_test

# Same frontend origin, exact scheme/host/port, with no trailing slash.
APP_ENV=development
AUTH_ORIGIN=http://localhost:5173
# Generate a private random key of at least 32 bytes in .env; keep stable across restarts.
AUTH_RATE_KEY=

# Existing private absolute directory OUTSIDE this repository and frontend/public.
# Required only for private photo upload/read. Create it with restricted OS access.
STORAGE_ROOT=

# Shared private directory for API/operator maintenance locks. Mandatory in production.
# Use the same directory (same bind volume) in API, admin commands and backup runner.
OPERATIONS_ROOT=
